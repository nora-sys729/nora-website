---
const featured = {
	title: "Why Blockchain Is Really About Trust",
	description:
		"I used to think blockchain was mainly about cryptocurrency. The more I learn about it, the more I think the interesting question is not whether blockchain removes trust — but who we choose to trust instead.",
	category: "Technology · Economics",
	date: "August 2026",
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Writing about economics, technology, AI, automation and women's economic independence."
		/>
		<title>Meng — Economics · Technology · Writing</title>

		<style>
			:root {
				--background: #f4f1ea;
				--text: #171717;
				--muted: #6d6a64;
				--line: #d6d1c7;
				--accent: #8f4f3a;
				--max-width: 1280px;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				background: var(--background);
				color: var(--text);
				font-family: Arial, Helvetica, sans-serif;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.site {
				width: min(var(--max-width), calc(100% - 48px));
				margin: 0 auto;
			}

			header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 28px 0;
				border-bottom: 1px solid var(--line);
			}

			.logo {
				font-size: 18px;
				font-weight: 700;
				letter-spacing: -0.04em;
			}

			nav {
				display: flex;
				gap: 28px;
				font-size: 13px;
			}

			nav a:hover {
				color: var(--accent);
			}

			.hero {
				min-height: 72vh;
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				align-items: center;
				gap: 80px;
				padding: 80px 0;
			}

			.eyebrow {
				margin-bottom: 24px;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
			}

			h1 {
				max-width: 900px;
				margin: 0;
				font-size: clamp(56px, 8vw, 118px);
				line-height: 0.9;
				letter-spacing: -0.075em;
				font-weight: 700;
			}

			.hero-text {
				max-width: 360px;
				margin-top: 36px;
				font-size: 18px;
				line-height: 1.5;
				color: var(--muted);
			}

			.hero-side {
				align-self: end;
				padding-bottom: 12px;
			}

			.hero-side p {
				max-width: 300px;
				margin: 0 0 24px;
				font-family: Georgia, serif;
				font-size: 25px;
				line-height: 1.25;
			}

			.arrow {
				font-size: 28px;
			}

			section {
				border-top: 1px solid var(--line);
				padding: 80px 0;
			}

			.section-label {
				margin-bottom: 50px;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			.featured {
				display: grid;
				grid-template-columns: 0.7fr 1.3fr;
				gap: 60px;
			}

			.featured h2 {
				margin: 0;
				max-width: 850px;
				font-family: Georgia, serif;
				font-size: clamp(42px, 6vw, 82px);
				font-weight: 400;
				line-height: 0.98;
				letter-spacing: -0.05em;
			}

			.featured-info {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-height: 280px;
			}

			.featured-description {
				max-width: 420px;
				font-size: 17px;
				line-height: 1.6;
				color: var(--muted);
			}

			.meta {
				font-size: 12px;
				color: var(--muted);
			}

			.read {
				display: inline-block;
				margin-top: 28px;
				font-size: 13px;
				font-weight: 700;
			}

			.read:hover {
				color: var(--accent);
			}

			.topics {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				border-top: 1px solid var(--line);
			}

			.topic {
				min-height: 180px;
				padding: 28px;
				border-right: 1px solid var(--line);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.topic:last-child {
				border-right: none;
			}

			.topic-number {
				font-size: 12px;
				color: var(--muted);
			}

			.topic-name {
				font-family: Georgia, serif;
				font-size: 28px;
			}

			.about {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 80px;
			}

			.about h2 {
				margin: 0;
				font-size: clamp(40px, 5vw, 72px);
				line-height: 0.95;
				letter-spacing: -0.06em;
			}

			.about p {
				max-width: 520px;
				margin: 0;
				font-family: Georgia, serif;
				font-size: 24px;
				line-height: 1.35;
			}

			footer {
				padding: 35px 0;
				border-top: 1px solid var(--line);
				display: flex;
				justify-content: space-between;
				font-size: 12px;
				color: var(--muted);
			}

			@media (max-width: 800px) {
				.site {
					width: min(100% - 28px, var(--max-width));
				}

				nav {
					gap: 14px;
				}

				.hero,
				.featured,
				.about {
					grid-template-columns: 1fr;
					gap: 45px;
				}

				.hero {
					min-height: auto;
					padding: 70px 0;
				}

				h1 {
					font-size: clamp(52px, 16vw, 90px);
				}

				.topics {
					grid-template-columns: 1fr 1fr;
				}

				.topic:nth-child(2) {
					border-right: none;
				}

				.topic:nth-child(-n + 2) {
					border-bottom: 1px solid var(--line);
				}
			}
		</style>
	</head>

	<body>
		<div class="site">
			<header>
				<a class="logo" href="/">MENG</a>

				<nav>
					<a href="#writing">Writing</a>
					<a href="#work">Work</a>
					<a href="#about">About</a>
				</nav>
			</header>

			<main>
				<section class="hero">
					<div>
						<div class="eyebrow">Economics · Technology · Writing</div>

						<h1>
							Technology changes
							how we work.
						</h1>

						<p class="hero-text">
							I write about economics, AI, automation,
							women's economic independence, and the
							ways technology changes our lives.
						</p>
					</div>

					<div class="hero-side">
						<p>
							A personal space for ideas,
							research, experiments and things
							I am still trying to understand.
						</p>

						<div class="arrow">↓</div>
					</div>
				</section>

				<section id="writing">
					<div class="section-label">Featured writing</div>

					<div class="featured">
						<div class="featured-info">
							<div>
								<div class="meta">
									{featured.category} · {featured.date}
								</div>

								<a class="read" href="#">
									Read article →
								</a>
							</div>
						</div>

						<div>
							<h2>{featured.title}</h2>

							<p class="featured-description">
								{featured.description}
							</p>
						</div>
					</div>
				</section>

				<section>
					<div class="section-label">What I'm exploring</div>

					<div class="topics">
						<a class="topic" href="#">
							<span class="topic-number">01</span>
							<span class="topic-name">Women & Economics</span>
						</a>

						<a class="topic" href="#">
							<span class="topic-number">02</span>
							<span class="topic-name">AI & Work</span>
						</a>

						<a class="topic" href="#">
							<span class="topic-number">03</span>
							<span class="topic-name">Automation</span>
						</a>

						<a class="topic" href="#">
							<span class="topic-number">04</span>
							<span class="topic-name">Technology & Society</span>
						</a>
					</div>
				</section>

				<section id="work">
					<div class="section-label">Work</div>

					<div class="topics">
						<a class="topic" href="#">
							<span class="topic-number">01</span>
							<span class="topic-name">Research</span>
						</a>

						<a class="topic" href="#">
							<span class="topic-number">02</span>
							<span class="topic-name">AI Experiments</span>
						</a>

						<a class="topic" href="#">
							<span class="topic-number">03</span>
							<span class="topic-name">Automation</span>
						</a>

						<a class="topic" href="#">
							<span class="topic-number">04</span>
							<span class="topic-name">Projects</span>
						</a>
					</div>
				</section>

				<section id="about">
					<div class="about">
						<h2>
							I'm interested in what happens when
							economics meets technology.
						</h2>

						<p>
							I'm currently studying economics and exploring
							how AI, automation and new technologies change
							work, productivity and economic independence.
							This website is where I collect my writing,
							research and experiments.
						</p>
					</div>
				</section>
			</main>

			<footer>
				<span>© 2026 MENG</span>
				<span>Writing · Research · Experiments</span>
			</footer>
		</div>
	</body>
</html>