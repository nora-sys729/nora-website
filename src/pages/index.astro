---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import FeaturedWriting from "../components/FeaturedWriting.astro";
import Topics from "../components/Topics.astro";
import Work from "../components/Work.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Writing about economics, technology, AI, automation and women's economic independence."
		/>
		<title>Meng — Economics · Technology · Writing</title>
	</head>

	<body>
		<div class="site">
			<Header />

			<main>
				<Hero />
				<FeaturedWriting />
				<Topics />
				<Work />
				<About />
			</main>

			<Footer />
		</div>
	</body>
</html>