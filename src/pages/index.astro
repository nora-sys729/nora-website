```astro
---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("writing");

/*
 * Featured article
 * For now, this is your English version of
 * "If Economics Is More Than Wealth..."
 */
const featuredPost = posts.find(
	(post) => post.id === "economics-more-than-wealth/en"
);

/*
 * Sort all articles by date, newest first.
 */
const sortedPosts = [...posts].sort(
	(a, b) =>
		new Date(b.data.date).getTime() -
		new Date(a.data.date).getTime()
);

/*
 * Build article URLs.
 * import.meta.env.BASE_URL makes this work both locally
 * and on GitHub Pages under /nora-website/.
 */
const getPostUrl = (id: string) =>
	`${import.meta.env.BASE_URL}writing/${id}/`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<meta
			name="description"
			content="Nora's writing on economics, technology, AI, automation and women's economic independence."
		/>

		<title>NORA — Writing, Research, Experiments</title>
	</head>

	<body>
		<div class="site">
			<Header />

			<main>
				<!-- =========================
				     HERO
				     ========================= -->

				<section class="hero">
					<div>
						<div class="eyebrow">NORA</div>

						<h1>
							Ideas I am
							thinking
							through.
						</h1>

						<p class="hero-text">
							Essays and notes about economics,
							technology, AI, automation and
							women's economic independence.
						</p>
					</div>
				</section>

				<!-- =========================
				     FEATURED WRITING
				     ========================= -->

				{featuredPost && (
					<section>
						<div class="section-label">
							Featured Writing
						</div>

						<a
							class="featured"
							href={getPostUrl(featuredPost.id)}
						>
							<div class="featured-info">
								<div>
									<div class="meta">
										{featuredPost.data.category}
										{" · "}
										{new Date(
											featuredPost.data.date
										).toLocaleDateString(
											"en-US",
											{
												year: "numeric",
												month: "long",
											}
										)}
									</div>

									<div class="read">
										Read article →
									</div>
								</div>
							</div>

							<div>
								<h2>
									{featuredPost.data.title}
								</h2>

								<p class="featured-description">
									{featuredPost.data.description}
								</p>
							</div>
						</a>
					</section>
				)}

				<!-- =========================
				     ALL WRITING
				     ========================= -->

				<section>
					<div class="section-label">
						All Writing
					</div>

					<div class="writing-items">
						{sortedPosts.map((post) => (
							<a
								class="writing-item"
								href={getPostUrl(post.id)}
							>
								<div class="writing-item-meta">
									<span>
										{post.data.category}
									</span>

									<span>
										{new Date(
											post.data.date
										).toLocaleDateString(
											"en-US",
											{
												year: "numeric",
												month: "short",
												day: "numeric",
											}
										)}
									</span>
								</div>

								<div class="writing-item-main">
									<h2>
										{post.data.title}
									</h2>

									<p>
										{post.data.description}
									</p>
								</div>

								<div class="writing-item-arrow">
									→
								</div>
							</a>
						))}
					</div>
				</section>

				<!-- =========================
				     TOPICS
				     ========================= -->

				<section>
					<div class="section-label">
						What I'm Exploring
					</div>

					<div class="topics">
						<div class="topic">
							<div class="topic-number">
								01
							</div>

							<div class="topic-name">
								Economics
							</div>
						</div>

						<div class="topic">
							<div class="topic-number">
								02
							</div>

							<div class="topic-name">
								Technology
							</div>
						</div>

						<div class="topic">
							<div class="topic-number">
								03
							</div>

							<div class="topic-name">
								AI & Automation
							</div>
						</div>

						<div class="topic">
							<div class="topic-number">
								04
							</div>

							<div class="topic-name">
								Economic Independence
							</div>
						</div>
					</div>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>
```
