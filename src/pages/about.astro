---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<meta
			name="description"
			content="About NORA — economics, technology, AI, automation and robotics."
		/>

		<title>About — NORA</title>
	</head>

	<body>
		<div class="site">
			<Header />

			<main>
				<section class="about-page">
					<div class="eyebrow">About</div>

					<h1>
						I am interested in
						what happens when
						economics meets
						technology.
					</h1>

					<div class="about-grid">
						<div>
							<p class="about-lead">
								I study economics and explore how
								technology changes the way we work,
								create value and build economic
								independence.
							</p>
						</div>

						<div class="about-copy">
							<p>
								My interests sit at the intersection
								of economics, artificial intelligence,
								automation and robotics.
							</p>

							<p>
								I am particularly interested in what
								these technologies mean for women,
								work and economic independence.
							</p>

							<p>
								This website is where I collect my
								writing, research, experiments and
								things I am still trying to understand.
							</p>
						</div>
					</div>

					<section class="about-interests">
						<div class="section-label">Currently exploring</div>

						<div class="topics">
							<div class="topic">
								<span class="topic-number">01</span>
								<span class="topic-name">
									Women & Economics
								</span>
							</div>

							<div class="topic">
								<span class="topic-number">02</span>
								<span class="topic-name">
									AI & Work
								</span>
							</div>

							<div class="topic">
								<span class="topic-number">03</span>
								<span class="topic-name">
									Automation
								</span>
							</div>

							<div class="topic">
								<span class="topic-number">04</span>
								<span class="topic-name">
									Robotics
								</span>
							</div>
						</div>
					</section>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>