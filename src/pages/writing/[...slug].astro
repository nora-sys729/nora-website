```astro
---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("writing");

	return posts.map((post) => ({
		params: {
			slug: post.id,
		},
		props: {
			post,
		},
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const isChinese = post.data.language === "zh";

const englishId = post.id.endsWith("/zh")
	? post.id.replace(/\/zh$/, "/en")
	: post.id.endsWith("/en")
		? post.id
		: `${post.id}/en`;

const chineseId = post.id.endsWith("/en")
	? post.id.replace(/\/en$/, "/zh")
	: post.id.endsWith("/zh")
		? post.id
		: `${post.id}/zh`;

const languageSwitchId = isChinese ? englishId : chineseId;
const languageLabel = isChinese ? "EN" : "中文";

const articleUrl = `/nora-website/writing/${post.id}/`;
const languageUrl = `/nora-website/writing/${languageSwitchId}/`;
---

<html lang={isChinese ? "zh-CN" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<meta
			name="description"
			content={post.data.description}
		/>

		<title>{post.data.title} — NORA</title>
	</head>

	<body>
		<div class="site">
			<Header />

			<main>
				<article class="article">

					<div class="article-navigation">
						<a class="article-back" href="/nora-website/writing/">
							← Writing
						</a>

						<a class="article-language" href={languageUrl}>
							{languageLabel}
						</a>
					</div>

					<header class="article-header">

						<div class="eyebrow">
							{post.data.category}
						</div>

						<h1>{post.data.title}</h1>

						<p class="article-description">
							{post.data.description}
						</p>

						<div class="article-date">
							{post.data.date.toLocaleDateString(
								isChinese ? "zh-CN" : "en-US",
								{
									year: "numeric",
									month: "long",
									day: "numeric",
								}
							)}
						</div>

					</header>

					<div class="article-content">
						<Content />
					</div>

				</article>
			</main>

			<Footer />
		</div>
	</body>
</html>
```
