---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("writing");

	return posts.map((post) => ({
		params: {
			slug: post.id,
		},
		props: {
			post,
		},
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL;

const isEnglish = post.data.language === "en";
const isChinese = post.data.language === "zh";

let languageUrl = "";
let languageLabel = "";

if (isEnglish) {
	const zhPost = await getCollection("writing", ({ id }) =>
		id === "economics-more-than-wealth/zh"
	);

	if (zhPost.length > 0) {
		languageUrl = `${base}writing/${zhPost[0].id}/`;
		languageLabel = "中文";
	}
}

if (isChinese) {
	const enPost = await getCollection("writing", ({ id }) =>
		id === "economics-more-than-wealth/en"
	);

	if (enPost.length > 0) {
		languageUrl = `${base}writing/${enPost[0].id}/`;
		languageLabel = "English";
	}
}
---

<html lang={post.data.language === "zh" ? "zh-CN" : "en"}>
	<head>
		<meta charset="utf-8" />

		<meta
			name="viewport"
			content="width=device-width"
		/>

		<meta
			name="description"
			content={post.data.description}
		/>

		<title>
			{post.data.title} — NORA
		</title>
	</head>

	<body>
		<div class="site">
			<Header />

			<main>
				<article class="article">
					<div class="article-navigation">
						<a
							class="article-back"
							href={`${base}writing/`}
						>
							← Writing
						</a>

						{languageUrl && (
							<a
								class="article-language"
								href={languageUrl}
							>
								{languageLabel} →
							</a>
						)}
					</div>

					<header class="article-header">
						<div class="eyebrow">
							{post.data.category}
						</div>

						<h1>
							{post.data.title}
						</h1>

						<p class="article-description">
							{post.data.description}
						</p>

						<div class="article-date">
							{new Date(
								post.data.date
							).toLocaleDateString(
								post.data.language === "zh"
									? "zh-CN"
									: "en-US",
								{
									year: "numeric",
									month: "long",
									day: "numeric",
								}
							)}
						</div>
					</header>

					<div class="article-content">
						<Content />
					</div>
				</article>
			</main>

			<Footer />
		</div>
	</body>
</html>