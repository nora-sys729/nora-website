---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getCollection } from "astro:content";

const posts = await getCollection("writing");

const sortedPosts = posts.sort(
	(a, b) =>
		new Date(b.data.date).getTime() -
		new Date(a.data.date).getTime()
);

const getPostUrl = (id: string) => {
	return `${import.meta.env.BASE_URL}writing/${id}/`;
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width"
		/>

		<title>Writing — NORA</title>
	</head>

	<body>
		<div class="site">
			<Header />

			<main>
				<section class="writing-hero">
					<div class="eyebrow">
						Writing
					</div>

					<h1>
						Ideas I am
						thinking through.
					</h1>

					<p>
						Essays, notes and questions about
						economics, technology, AI,
						automation and the future.
					</p>
				</section>

				<section class="writing-list">
					<div class="writing-items">
						{sortedPosts.map((post) => (
							<a
								class="writing-item"
								href={getPostUrl(post.id)}
							>
								<div class="writing-item-meta">
									<span>
										{post.data.category}
									</span>

									<span>
										{new Date(
											post.data.date
										).toLocaleDateString(
											"en-US",
											{
												year: "numeric",
												month: "short",
												day: "numeric",
											}
										)}
									</span>
								</div>

								<div class="writing-item-main">
									<h2>
										{post.data.title}
									</h2>

									<p>
										{post.data.description}
									</p>
								</div>

								<div class="writing-item-arrow">
									→
								</div>
							</a>
						))}
					</div>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>